{
	"dependencies": {
		"@ls-lint/ls-lint": "^2.3.1",
		"branch-name-lint": "^3.0.1",
		"knip": "^6.41.0",
		"lint-staged": "^17.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@commitlint/cli": "^20.4.4",
		"@commitlint/config-conventional": "^20.4.4",
		"@commitlint/types": "^20.4.4",
		"@types/node": "^22.9.0",
		"gh-pages": "^6.3.0",
